generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USERS ───────────────────────────────────────────────

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  username         String?  @unique
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  contact          String
  role             Role     @default(FARMER)
  municipality     String?
  province         String   @default("Iloilo")
  phoneNumber      String?  @map("phone_number")
  municipalityId   Int?     @map("municipality_id")
  vehicleType      String?  @map("vehicle_type")
  licenseNumber    String?  @map("license_number")
  isVerifiedDriver Boolean  @default(false) @map("is_verified_driver")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  municipalityRef   Municipality?          @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  wallet            Wallet?
  ledgerEntries     LedgerEntry[]
  harvestBatches    HarvestBatch[]         @relation("FarmerHarvests")
  acceptedBatches   HarvestBatch[]         @relation("AcceptedMiller")
  harvestInterests  HarvestInterest[]
  finishedStocks    FinishedRiceStock[]
  deliverySettings  MillerDeliverySetting?
  processingLogs    MillerProcessingLog[]
  storageCapacity   MillerStorageCapacity?
  millingQueues     MillingQueue[]
  millerFleet       MillerDriver[]         @relation("MillerFleet")
  driverFleet       MillerDriver[]         @relation("DriverFleet")
  bookings          Booking[]
  notifications     Notification[]

  @@map("users")
}

enum Role {
  ADMIN
  FARMER
  MILLER
  RETAILER
  DRIVER
}

// ─── MUNICIPALITIES ──────────────────────────────────────

model Municipality {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  distanceIndex Int      @map("distance_index")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users            User[]
  deliverySettings MillerDeliverySetting[]

  @@map("municipalities")
}

// ─── HARVEST BATCHES ─────────────────────────────────────

model HarvestBatch {
  id                  Int       @id @default(autoincrement())
  userId              String    @map("user_id")
  buyerId             String?   @map("buyer_id")
  driverId            String?   @map("driver_id")
  location            String?
  riceVariety         String    @map("rice_variety")
  condition           String    @default("fresh")
  numberOfBags        Int       @default(0) @map("number_of_bags")
  totalWeight         Decimal   @db.Decimal(8, 2) @map("total_weight")
  actualWeightKg      Decimal?  @db.Decimal(10, 2) @map("actual_weight_kg")
  unpackedWeightKg    Decimal?  @db.Decimal(8, 2) @map("unpacked_weight_kg")
  pricePerKg          Decimal?  @db.Decimal(8, 2) @map("price_per_kg")
  suggestedPricePerKg Decimal?  @db.Decimal(10, 2) @map("suggested_price_per_kg")
  finalPricePerKg     Decimal?  @db.Decimal(10, 2) @map("final_price_per_kg")
  pricePerSack        Decimal?  @db.Decimal(8, 2) @map("price_per_sack")
  totalSacks          Int       @default(0) @map("total_sacks")
  harvestDate         DateTime  @map("harvest_date")
  scheduledPickupDate DateTime? @map("scheduled_pickup_date")
  routeSequence       Int?      @map("route_sequence")
  status              String    @default("unsold")
  dryingStatus        String?   @map("drying_status")
  deliveryMethod      String?   @map("delivery_method")
  deliveryStatus      String    @default("Pending") @map("delivery_status")
  deliveryType        String    @default("palay") @map("delivery_type")
  hiddenFromFarmer    Boolean   @default(false) @map("hidden_from_farmer")
  hiddenAt            DateTime? @map("hidden_at")
  acceptedMillerId    String?   @map("accepted_miller_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  farmer         User              @relation("FarmerHarvests", fields: [userId], references: [id], onDelete: Cascade)
  acceptedMiller User?             @relation("AcceptedMiller", fields: [acceptedMillerId], references: [id], onDelete: SetNull)
  interests      HarvestInterest[]
  bookings       Booking[]

  @@index([deliveryType])
  @@map("harvest_batches")
}

// ─── HARVEST INTERESTS ───────────────────────────────────

model HarvestInterest {
  id        Int      @id @default(autoincrement())
  harvestId Int      @map("harvest_id")
  millerId  String   @map("miller_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  harvest HarvestBatch @relation(fields: [harvestId], references: [id], onDelete: Cascade)
  miller  User         @relation(fields: [millerId], references: [id], onDelete: Cascade)

  @@unique([harvestId, millerId])
  @@map("harvest_interests")
}

// ─── WALLETS ─────────────────────────────────────────────

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// ─── LEDGER ENTRIES ──────────────────────────────────────

model LedgerEntry {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id")
  amount        Decimal  @db.Decimal(15, 2)
  type          String
  referenceType String?  @map("reference_type")
  referenceId   Int?     @map("reference_id")
  description   String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([referenceType, referenceId, userId, type], name: "ledger_entries_ref_user_type_unique")
  @@map("ledger_entries")
}

// ─── FINISHED RICE STOCKS ────────────────────────────────

model FinishedRiceStock {
  id                Int      @id @default(autoincrement())
  millerId          String   @map("miller_id")
  riceVariety       String   @map("rice_variety")
  totalSacks        Int      @default(0) @map("total_sacks")
  unpackedWeightKg  Decimal  @default(0) @db.Decimal(8, 2) @map("unpacked_weight_kg")
  pricePerSack      Decimal? @db.Decimal(8, 2) @map("price_per_sack")
  lowStockThreshold Int      @default(50) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  miller User @relation(fields: [millerId], references: [id], onDelete: Cascade)

  @@map("finished_rice_stocks")
}

// ─── MARKET PRICES ───────────────────────────────────────

model MarketPrice {
  id           Int      @id @default(autoincrement())
  riceVariety  String   @map("rice_variety")
  pricePerKg   Decimal  @db.Decimal(10, 2) @map("price_per_kg")
  marketRegion String   @map("market_region")
  priceDate    DateTime @map("price_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([riceVariety, priceDate])
  @@map("market_prices")
}

// ─── BOOKINGS ────────────────────────────────────────────

model Booking {
  id                 Int      @id @default(autoincrement())
  bookableType       String   @map("bookable_type")
  bookableId         Int      @map("bookable_id")
  originAddress      String   @map("origin_address")
  destinationAddress String   @map("destination_address")
  totalWeightKg      Decimal  @db.Decimal(8, 2) @map("total_weight_kg")
  estimatedSacks     Int      @map("estimated_sacks")
  driverId           String?  @map("driver_id")
  driverName         String?  @map("driver_name")
  status             String   @default("pending")
  orderId            Int?     @map("order_id")
  harvestBatchId     Int?     @map("harvest_batch_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  driver       User?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  harvestBatch HarvestBatch? @relation(fields: [harvestBatchId], references: [id], onDelete: SetNull)

  @@index([bookableType, bookableId])
  @@map("bookings")
}

// ─── NOTIFICATIONS ───────────────────────────────────────

model Notification {
  id                 String    @id @default(uuid())
  type               String
  notifiableType     String    @map("notifiable_type")
  notifiableId       String    @map("notifiable_id")
  data               Json
  notificationStatus String    @default("unread") @map("notification_status")
  readAt             DateTime? @map("read_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [notifiableId], references: [id], onDelete: Cascade)

  @@index([notifiableType, notifiableId])
  @@map("notifications")
}

// ─── MILLER DELIVERY SETTINGS ────────────────────────────

model MillerDeliverySetting {
  id                      Int      @id @default(autoincrement())
  millerId                String   @unique @map("miller_id")
  baseDeliveryFee         Decimal  @default(150) @db.Decimal(10, 2) @map("base_delivery_fee")
  extraFeePerMunicipality Decimal  @default(50) @db.Decimal(10, 2) @map("extra_fee_per_municipality")
  municipalityId          Int?     @map("municipality_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  miller       User          @relation(fields: [millerId], references: [id], onDelete: Cascade)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)

  @@map("miller_delivery_settings")
}

// ─── MILLER-DRIVER PIVOT ─────────────────────────────────

model MillerDriver {
  id        Int      @id @default(autoincrement())
  millerId  String   @map("miller_id")
  driverId  String   @map("driver_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  miller User @relation("MillerFleet", fields: [millerId], references: [id], onDelete: Cascade)
  driver User @relation("DriverFleet", fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([millerId, driverId])
  @@map("miller_driver")
}

// ─── MILLER PROCESSING LOGS ──────────────────────────────

model MillerProcessingLog {
  id                   Int       @id @default(autoincrement())
  userId               String    @map("user_id")
  inputPalayKg         Int       @map("input_palay_kg")
  outputRiceKg         Int       @map("output_rice_kg")
  huskWasteKg          Int       @map("husk_waste_kg")
  recoveryRate         Decimal   @db.Decimal(5, 2) @map("recovery_rate")
  processingEfficiency Decimal   @default(0) @db.Decimal(5, 2) @map("processing_efficiency")
  processingStart      DateTime  @map("processing_start")
  processingEnd        DateTime? @map("processing_end")
  status               String    @default("processing")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("miller_processing_logs")
}

// ─── MILLER STORAGE CAPACITY ─────────────────────────────

model MillerStorageCapacity {
  id                 Int      @id @default(autoincrement())
  userId             String   @unique @map("user_id")
  totalCapacityKg    Int      @map("total_capacity_kg")
  currentStockKg     Int      @default(0) @map("current_stock_kg")
  availableCapacityKg Int     @default(0) @map("available_capacity_kg")
  utilizationRate    Decimal  @default(0) @db.Decimal(5, 2) @map("utilization_rate")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("miller_storage_capacity")
}

// ─── MILLING QUEUES ──────────────────────────────────────

model MillingQueue {
  id                  Int       @id @default(autoincrement())
  millerId            String    @map("miller_id")
  palayKg             Int       @map("palay_kg")
  status              String    @default("pending")
  priority            Int       @default(5)
  queuedAt            DateTime  @map("queued_at")
  processingStartedAt DateTime? @map("processing_started_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  miller User @relation(fields: [millerId], references: [id], onDelete: Cascade)

  @@index([millerId, status])
  @@map("milling_queues")
}

// ─── ORDERS (deferred, minimal model for FK references) ──

model Order {
  id             Int      @id @default(autoincrement())
  retailerId     String   @map("retailer_id")
  millerId       String   @map("miller_id")
  stockId        Int?     @map("stock_id")
  driverId       String?  @map("driver_id")
  riceVariety    String   @map("rice_variety")
  sacks          Int
  totalWeight    Decimal  @db.Decimal(10, 2) @map("total_weight")
  totalPrice     Decimal  @db.Decimal(15, 2) @map("total_price")
  status         String   @default("pending_pickup")
  deliveryStatus String   @default("Pending") @map("delivery_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("orders")
}
